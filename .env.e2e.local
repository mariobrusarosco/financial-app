# E2E Testing - Local Development Environment
# This file is used by default when running tests locally

# Playwright Configuration
PLAYWRIGHT_BASE_URL=http://localhost:2000

# API Configuration (your local backend)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Test User Credentials (demo credentials from login form)
E2E_TEST_EMAIL=user@example.com
E2E_TEST_PASSWORD=password123

# Browser Configuration
# PLAYWRIGHT_HEADLESS is controlled by the script you run:
# - yarn test:e2e         → headless (no browser shown)
# - yarn test:e2e:headed  → headed (browser visible)
PLAYWRIGHT_SLOW_MO=0       # No slow motion (set to 100+ for debugging)

# Optional: MSW for API mocking
E2E_USE_MSW=false
