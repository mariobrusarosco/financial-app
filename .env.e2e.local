# E2E Testing Environment Variables - Local Development
#
# This file is used when running E2E tests locally against your local backend
# or any other backend of your choice.
#
# Usage: yarn test:e2e (automatically uses this file)
#
# To point to a different backend, modify VITE_API_BASE_URL below

# Playwright Configuration
PLAYWRIGHT_BASE_URL=http://localhost:5173

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Test User Credentials (for local backend)
# Create this user in your local database or use any existing test account
E2E_TEST_EMAIL=test@local.com
E2E_TEST_PASSWORD=TestPassword123!

# Optional: Enable MSW for API mocking (if needed)
# E2E_USE_MSW=false
