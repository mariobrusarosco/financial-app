# E2E Testing Environment Variables - Demo Environment (Template)
#
# This is a TEMPLATE file. Copy this to .env.e2e.demo and fill in actual values.
# The .env.e2e.demo file should be gitignored to protect credentials.
#
# Usage: E2E_ENV=demo yarn test:e2e
#
# Note: In CI/CD (GitHub Actions), these values are set via GitHub Secrets

# Playwright Configuration
PLAYWRIGHT_BASE_URL=https://demo.better-call-buffet.com

# API Configuration
VITE_API_BASE_URL=https://api-demo.better-call-buffet.com/api/v1

# Test User Credentials
# Use the dedicated e2e-test@demo.com account created in demo environment
E2E_TEST_EMAIL=e2e-test@demo.com
E2E_TEST_PASSWORD=<GET_FROM_TEAM_PASSWORD_MANAGER>

# MSW should be disabled for demo environment (testing real API)
E2E_USE_MSW=false
