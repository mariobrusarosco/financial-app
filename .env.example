# Environment variables for Better Call Buffet

# Base URL for the API (without trailing slash)
# Local development: http://localhost:8000/api/v1
# Production: https://your-production-api.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Browser observability
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
# Local dev is disabled in the browser by default. Enable only in deployed environments.
VITE_SENTRY_ENABLED=false

# Build-time source maps and release upload
# These variables are consumed by Vite/CI and must not be exposed via VITE_
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Defaults to the current git commit SHA when omitted and git metadata is available
SENTRY_RELEASE=
