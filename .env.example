# Environment variables for Better Call Buffet

# Base URL for the API (without trailing slash)
# Local development: http://localhost:8000/api/v1
# Production: https://your-production-api.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Authentication endpoints expected by the frontend:
# POST /auth/login - User login
# POST /auth/register - User registration  
# POST /auth/refresh - Token refresh
# GET /auth/me - Get current user
# POST /auth/logout - User logout
# GET /auth/validate - Validate session

# Add other environment variables required by the application below
# e.g., VITE_SOME_OTHER_CONFIG=
